    {
      "id": "accelerated-life",
      "title": "Life-stress relationships",
      "blurb": "How characteristic life responds to stress, for accelerated tests.",
      "entries": [
        {
          "id": "arrhenius",
          "name": "Arrhenius",
          "n_stress": 1,
          "log_life_axis": true,
          "summary": "Thermal acceleration — life = b·exp(a / stress). Use absolute temperature (K). The classic model for chemical/thermal ageing.",
          "coefficients": [
            "a",
            "b"
          ]
        },
        {
          "id": "eyring",
          "name": "Eyring",
          "n_stress": 1,
          "log_life_axis": true,
          "summary": "Thermal model derived from reaction-rate theory — a physically grounded alternative to Arrhenius.",
          "coefficients": [
            "a",
            "b"
          ]
        },
        {
          "id": "inverse_power",
          "name": "Inverse power law",
          "n_stress": 1,
          "log_life_axis": true,
          "summary": "Life = 1/(a·stress^n). The standard model for voltage, load or pressure acceleration.",
          "coefficients": [
            "a",
            "n"
          ]
        },
        {
          "id": "linear",
          "name": "Linear",
          "n_stress": 1,
          "log_life_axis": false,
          "summary": "Life = a + b·stress. A simple straight-line relationship.",
          "coefficients": [
            "a",
            "b"
          ]
        },
        {
          "id": "dual_exponential",
          "name": "Dual exponential (temp–humidity)",
          "n_stress": 2,
          "log_life_axis": true,
          "summary": "Two stresses combined exponentially — e.g. temperature and humidity (the Peck-style model).",
          "coefficients": [
            "a",
            "b",
            "c"
          ]
        },
        {
          "id": "power_exponential",
          "name": "Temperature–nonthermal",
          "n_stress": 2,
          "log_life_axis": true,
          "summary": "Temperature (exponential) with a second non-thermal stress (power) — e.g. temperature and voltage.",
          "coefficients": [
            "c",
            "a",
            "n"
          ]
        },
        {
          "id": "dual_power",
          "name": "Dual power",
          "n_stress": 2,
          "log_life_axis": true,
          "summary": "Two stresses combined by a power law.",
          "coefficients": [
            "c",
            "m",
            "n"
          ]
        }
      ]
    },
